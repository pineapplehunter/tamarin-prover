{
  "name": "tree-sitter-spthy",
  "version": "0.2.0",
  "description": "Spthy grammar for tree-sitter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamarin-prover/tamarin-prover.git",
    "directory": "tree-sitter/tree-sitter-spthy"
  },
  "license": "MIT",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "spthy"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "scripts/tree-sitter.js",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "prebuildify": "^6.0.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "node scripts/tree-sitter.js generate --abi 14",
    "install": "node-gyp-build",
    "prestart": "node scripts/tree-sitter.js build --wasm",
    "start": "node scripts/tree-sitter.js playground",
    "test": "npm run test:grammar && npm run test:bindings",
    "test:grammar": "node scripts/tree-sitter.js test",
    "test:bindings": "node --test bindings/node/*_test.js",
    "test:examples": "bash regressionParser.sh"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-cli@0.27.1": true
  }
}
